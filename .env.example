# Copy to .env.local. With nothing set, the app runs fully in demo mode
# (in-memory data, simulated payments, one-tap demo sign-in).

# Public URL of the app: used for QR codes, magic links and Stripe redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Landing page "Reserve a pilot spot" button target, e.g. https://wa.me/3069XXXXXXXX. Hidden when empty.
NEXT_PUBLIC_PILOT_URL=

# Supabase (Postgres, Auth, Realtime, Storage). Run supabase/migrations first.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe Connect. Live payments switch on only when Supabase is also configured.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Signs per-tip tokens (review, Google tap, manager message). Use a long random string in production.
TIP_TOKEN_SECRET=

# Platform commission on each tip (0.04 = 4%).
PLATFORM_TAKE_RATE=0.04
